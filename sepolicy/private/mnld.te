type mnld, domain;
net_domain(mnld)
typeattribute mnld mlstrustedsubject;
type mnld_exec, exec_type, vendor_file_type, file_type;

allow mnld proc_cmdline:file { getattr read open };
allow mnld sysfs_dt_firmware_android:dir search;
allow mnld sysfs_dt_firmware_android:file { getattr read open };
allow mnld metadata_file:dir search;
